# Security + caching headers.
#
# IF YOU SET SHOP.newsletterEndpoint: add that host to connect-src below,
# or the browser silently blocks the POST and sign-ups vanish with no error.
# Same for any new third-party script or image host.
# Read by Cloudflare Pages and Netlify. Other hosts need their own config —
# see README. Without this file the site ships no CSP at all.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com https://www.facebook.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://connect.facebook.net; form-action 'self'; upgrade-insecure-requests

# Fingerprinted assets: the ?v= hash changes whenever the file does,
# so these can be cached hard and forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=604800

# HTML must revalidate or customers keep seeing yesterday's menu.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
